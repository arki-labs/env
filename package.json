{
  "name": "@arki/env",
  "version": "0.2.0",
  "description": "Type-safe environment variable parsing for ARKI — defineEnv() built on @t3-oss/env-core with Zod presets for common variable shapes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arki-labs/arki.git"
  },
  "homepage": "https://arki.dev",
  "bugs": {
    "url": "https://github.com/arki-labs/arki/issues"
  },
  "keywords": [
    "arki",
    "typescript",
    "env",
    "environment",
    "zod",
    "t3-env",
    "config"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/node/register.js",
    "./src/node/register.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./presets": {
      "types": "./dist/presets/index.d.ts",
      "import": "./dist/presets/index.js",
      "default": "./dist/presets/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js",
      "default": "./dist/node/index.js"
    },
    "./node/register": {
      "types": "./dist/node/register.d.ts",
      "import": "./dist/node/register.js",
      "default": "./dist/node/register.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**",
    "src/**",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/tests/**",
    "!src/**/test/**",
    "!src/**/__tests__/**",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "llms.txt",
    "docs/agent-guide.md",
    "docs/upgrades/**",
    "package.json"
  ],
  "dependencies": {
    "@arki/failure": "0.3.0",
    "@arki/schema": "0.3.0",
    "@opentelemetry/api": "^1.9.1",
    "@t3-oss/env-core": "^0.13.11",
    "eciesjs": "^0.5.0",
    "zod": "4.6.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
